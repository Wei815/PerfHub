import subprocess
import time
import os

scrcpy_path = r'C:\Users\User\AppData\Local\Microsoft\WinGet\Packages\Genymobile.scrcpy_Microsoft.Winget.Source_8wekyb3d8bbwe\scrcpy-win64-v4.1\scrcpy.exe'
record_file = "test_stream.mkv"

if os.path.exists(record_file):
    os.remove(record_file)

cmd = [scrcpy_path, "-m", "1024", "-b", "2M", "--no-window", "--no-audio", "--video-codec=h264", "--record-format=mkv", f"--record={record_file}"]

print("Starting scrcpy to file...")
p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

time.sleep(2)

try:
    with open(record_file, "rb") as f:
        print("Success! Can read file while it's being written.")
        data = f.read(100)
        print(f"Read {len(data)} bytes: {data[:20]}")
except Exception as e:
    print(f"Failed to read file: {e}")

p.terminate()
