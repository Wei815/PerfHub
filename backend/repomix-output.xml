import subprocess
import time
import os

scrcpy_path = r'C:\Users\User\AppData\Local\Microsoft\WinGet\Packages\Genymobile.scrcpy_Microsoft.Winget.Source_8wekyb3d8bbwe\scrcpy-win64-v4.1\scrcpy.exe'
ffmpeg_path = r'C:\ffmpeg\bin\ffmpeg.exe' # Need to find ffmpeg too? Let's just test scrcpy first.

print("Starting scrcpy with pipe...")
# We emulate exactly what the server does:
cmd = f'"{scrcpy_path}" -V error -m 1024 -b 2M --no-window --no-audio --video-codec=h264 --record-format=mkv --record=-'
p = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

print("Reading from pipe...")
try:
    data = p.stdout.read(100)
    print(f"Read {len(data)} bytes")
    print(data.hex())
except Exception as e:
    print(f"Error reading: {e}")

time.sleep(2)
print("Process alive:", p.poll() is None)
p.terminate()
