import { Play, Pause, Trash2, Download, Activity, Cpu, HardDrive } from 'lucide-react';
import { useWebSocket } from './hooks/useWebSocket';
import DeviceScreen from './components/DeviceScreen';
import './index.css';

function App() {
  const {
    data,
    currentMetrics,
    status,
    errorMessage,
    isRecording,
    startRecording,
    pauseRecording,
    clearData,
    exportCSV
  } = useWebSocket('ws://127.0.0.1:8000/ws/perf');

  const { cpu_percent, memory_mb, fps } = currentMetrics;

  const isCpuDanger = cpu_percent > 80;
  const isFpsDanger = fps > 0 && fps < 45; // FPS is only danger if actively dropping below 45 (0 usually means not running/mock starting)

  return (
    <div className="app-container">
      <header className="header">
        <div>
          <h1>PerfHub Pro</h1>
          <h2>Client Performance Dashboard</h2>
          <div className="connection-status">
            {status === 'connected' ? (
              <span style={{ color: 'var(--success-color)' }}>● Connected to Device</span>
            ) : status === 'error' ? (
              <span style={{ color: 'var(--danger-color)' }}>● Error: {errorMessage}</span>
            ) : (
              <span style={{ color: 'var(--text-secondary)' }}>● Connecting...</span>
            )}
          </div>
        </div>

        <div className="controls glass-panel">
          <button 
            className="primary" 
            onClick={isRecording ? pauseRecording : startRecording}
            disabled={status !== 'connected'}
          >
            {isRecording ? <><Pause size={18}/> Pause</> : <><Play size={18}/> Start</>}
          </button>
          <button onClick={clearData}><Trash2 size={18}/> Clear</button>
          <button onClick={exportCSV} disabled={data.length === 0}><Download size={18}/> Export CSV</button>
        </div>
      </header>

      {status === 'error' && (
        <div className="glass-panel" style={{ marginBottom: '2rem', borderColor: 'var(--danger-color)', backgroundColor: 'var(--danger-bg)' }}>
          <h3 style={{ color: 'var(--danger-color)', marginTop: 0 }}>Device Error</h3>
          <p>{errorMessage}. Please check USB connection and target package.</p>
        </div>
      )}

      <div style={{ display: 'flex', gap: '2rem', flexWrap: 'wrap' }}>
        {/* Left Side: Device Screen */}
        <div style={{ flex: '1 1 350px', maxWidth: '500px' }}>
          <DeviceScreen />
        </div>

        {/* Right Side: Dashboard */}
        <div style={{ flex: '2 1 600px' }}>
          <div className="cards-grid">
            <div className={`status-card glass-panel ${isCpuDanger ? 'danger' : ''}`}>
              <div className="label"><Cpu size={16} style={{display: 'inline', verticalAlign: 'text-bottom', marginRight: '4px'}}/> CPU Usage</div>
              <div className="value">
                {cpu_percent.toFixed(1)} <span className="unit">%</span>
              </div>
            </div>

            <div className="status-card glass-panel">
              <div className="label"><HardDrive size={16} style={{display: 'inline', verticalAlign: 'text-bottom', marginRight: '4px'}}/> Memory PSS</div>
              <div className="value">
                {memory_mb.toFixed(1)} <span className="unit">MB</span>
              </div>
            </div>

            <div className={`status-card glass-panel ${isFpsDanger ? 'danger' : ''}`}>
              <div className="label"><Activity size={16} style={{display: 'inline', verticalAlign: 'text-bottom', marginRight: '4px'}}/> FPS</div>
              <div className="value">
                {fps} <span className="unit">Hz</span>
              </div>
            </div>
          </div>

          <div className="charts-grid">
            <div className="glass-panel">
              <h3>CPU Trend</h3>
              <div className="chart-container">
                <ResponsiveContainer width="100%" height="100%">
                  <LineChart data={data} margin={{ top: 5, right: 20, bottom: 5, left: 0 }}>
                    <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.1)" />
                    <XAxis dataKey="time" stroke="var(--text-secondary)" tick={{fontSize: 12}} />
                    <YAxis domain={[0, 100]} stroke="var(--text-secondary)" tick={{fontSize: 12}} />
                    <Tooltip 
                      contentStyle={{ backgroundColor: 'var(--panel-bg)', borderColor: 'rgba(255,255,255,0.1)', borderRadius: '8px' }}
                      itemStyle={{ color: 'var(--text-primary)' }}
                    />
                    <Line type="monotone" dataKey="cpu" stroke="var(--accent-color)" strokeWidth={2} dot={false} isAnimationActive={false} />
                  </LineChart>
                </ResponsiveContainer>
              </div>
            </div>

            <div className="glass-panel">
              <h3>Memory Trend (MB)</h3>
              <div className="chart-container">
                <ResponsiveContainer width="100%" height="100%">
                  <LineChart data={data} margin={{ top: 5, right: 20, bottom: 5, left: 0 }}>
                    <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.1)" />
                    <XAxis dataKey="time" stroke="var(--text-secondary)" tick={{fontSize: 12}} />
                    <YAxis domain={['auto', 'auto']} stroke="var(--text-secondary)" tick={{fontSize: 12}} />
                    <Tooltip 
                      contentStyle={{ backgroundColor: 'var(--panel-bg)', borderColor: 'rgba(255,255,255,0.1)', borderRadius: '8px' }}
                      itemStyle={{ color: 'var(--text-primary)' }}
                    />
                    <Line type="monotone" dataKey="memory" stroke="#a78bfa" strokeWidth={2} dot={false} isAnimationActive={false} />
                  </LineChart>
                </ResponsiveContainer>
              </div>
            </div>

            <div className="glass-panel">
