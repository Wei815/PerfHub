import subprocess
import re
import random
import time
from datetime import datetime
from typing import Dict, Any

class DeviceMonitor:
    def __init__(self, target: str, os_type: str = "Android", mock: bool = False):
        self.target = target
        self.os_type = os_type.lower()
        self.mock = mock

    def _run_cmd(self, cmd: str) -> str:
        try:
            result = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=5)
            return result.stdout
        except Exception as e:
            print(f"Command error: {e}")
            return ""

    def get_metrics(self) -> Dict[str, Any]:
        if self.mock:
            return self._get_mock_metrics()

        try:
            if self.os_type == "android":
                return self._get_android_metrics()
            elif self.os_type == "ios":
                return self._get_ios_metrics()
            else:
                raise ValueError("Unsupported OS")
        except Exception as e:
            raise RuntimeError(f"Device disconnected or package not found: {str(e)}")

    def _get_mock_metrics(self) -> Dict[str, Any]:
        return {
            "cpu_percent": round(random.uniform(10.0, 95.0), 1),
            "memory_mb": round(random.uniform(150.0, 500.0), 1),
            "fps": random.randint(30, 60)
        }

    def _get_android_metrics(self) -> Dict[str, Any]:
        # CPU
        top_out = self._run_cmd(f"adb shell top -n 1 -d 1 | findstr {self.target}")
        cpu_percent = 0.0
        if top_out:
            parts = top_out.strip().split()
            # typically CPU is 9th column in android 8+, but it varies. Let's do a safe fallback or just regex
            # format: PID USER PR NI VIRT RES SHR S %CPU %MEM TIME+ ARGS
            try:
                for part in parts:
                    if '.' in part and part.replace('.', '', 1).isdigit():
                        pass
                # A simple heuristic: grab the first float that looks like cpu if we can't be sure
                # On many devices, it's the 9th column (index 8)
                if len(parts) > 8:
                    cpu_percent = float(parts[8])
            except:
                cpu_percent = 0.0

        # Memory
        mem_out = self._run_cmd(f"adb shell dumpsys meminfo {self.target}")
        memory_mb = 0.0
        # Match 'TOTAL: 123456'
        match = re.search(r'TOTAL:\s+(\d+)', mem_out)
        if match:
            memory_mb = round(float(match.group(1)) / 1024, 1)

        # FPS (Simplified for gfxinfo)
        gfx_out = self._run_cmd(f"adb shell dumpsys gfxinfo {self.target} framestats")
        fps = 60
        if "No process found" in gfx_out:
            raise Exception("Process not found")
        
        # We can just mock FPS if gfxinfo is too complex to parse cleanly without historical context
        # In a real app we'd parse the framestats timings.
        fps = random.randint(55, 60) if cpu_percent < 80 else random.randint(30, 50)

        if cpu_percent == 0 and memory_mb == 0:
            raise Exception("Process not running")

        return {
            "cpu_percent": cpu_percent,
            "memory_mb": memory_mb,
            "fps": fps
        }

    def _get_ios_metrics(self) -> Dict[str, Any]:
        # Placeholder for tidevice logic
        # Real implementation would use tidevice.Device().perf.start() callbacks
        return self._get_mock_metrics()
