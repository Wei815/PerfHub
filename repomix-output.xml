<file path="frontend/src/index.css">
:root {
  --bg-color: #0f172a;
  --panel-bg: rgba(30, 41, 59, 0.6);
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --accent-color: #3b82f6;
  --accent-hover: #2563eb;
  --danger-color: #ef4444;
  --danger-bg: rgba(239, 68, 68, 0.1);
  --success-color: #10b981;
  --success-bg: rgba(16, 185, 129, 0.1);
  
  font-family: 'Inter', system-ui, sans-serif;
  color-scheme: dark;
  color: var(--text-primary);
  background-color: var(--bg-color);
}

body {
  margin: 0;
  min-height: 100vh;
  background: radial-gradient(circle at top center, #1e293b 0%, #0f172a 100%);
  overflow: hidden; /* 防止整個頁面滾動，僅允許內部區塊滾動 */
}

.app-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 1.5rem 3rem;
  box-sizing: border-box;
  max-width: 100%;
  margin: 0 auto;
}

/* 玻璃擬態面板共用屬性 */
.glass-panel {
  background: var(--panel-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
}

/* ================= 頂部導覽列 ================= */
.topbar {
  display: flex;
  align-items: center;
  padding: 0.75rem 1.5rem;
  margin-bottom: 1.5rem;
}

.brand {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.brand h1 {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 800;
  background: linear-gradient(135deg, #60a5fa 0%, #c084fc 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.badge {
  background: rgba(96, 165, 250, 0.2);
  color: #60a5fa;
  padding: 0.2rem 0.6rem;
  border-radius: 6px;
  font-size: 0.75rem;
  font-weight: 600;
  border: 1px solid rgba(96, 165, 250, 0.3);
}

/* ================= 三欄式佈局 (核心) ================= */
.main-layout {
  display: grid;
  grid-template-columns: 320px minmax(400px, 4fr) minmax(450px, 5fr);
  gap: 2rem;
  flex: 1;
  min-height: 0; /* 讓 Grid 內部可捲動的關鍵 */
}

/* ---------- 左欄：控制面板 ---------- */
.left-panel {
  display: flex;
  flex-direction: column;
  padding: 1.5rem;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 1rem;
  color: #e2e8f0;
  margin: 0 0 1rem 0;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  font-size: 0.9rem;
  gap: 0.5rem;
}

.info-item .label {
  color: var(--text-secondary);
  white-space: nowrap;
}

.info-item .value {
  font-family: monospace;
  font-size: 0.95rem;
  text-align: right;
  word-break: break-word;
}

.text-success { color: var(--success-color); display: flex; align-items: center; gap: 4px; }
.text-danger { color: var(--danger-color); display: flex; align-items: center; gap: 4px;}

.mt-auto { margin-top: auto; padding-top: 2rem;}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

/* ---------- 中欄：手機畫面 ---------- */
.center-panel {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 1rem;
  overflow: hidden;
}

/* 移除 DeviceScreen 內建的多餘邊框，融入中欄 */
.center-panel .device-screen-container.glass-panel {
  border: none;
  background: transparent;
  box-shadow: none;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}
.center-panel h3 { display: none; } /* 隱藏舊的標題 */
.center-panel canvas {
  max-height: 100%;
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

/* ---------- 右欄：數據面板 ---------- */
.right-panel {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  min-height: 0;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem;
}

.metric-card {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.metric-label {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 0.75rem;
  color: var(--text-secondary);
  text-transform: uppercase;
  margin-bottom: 0.5rem;
}

.metric-value {
  font-size: 1.8rem;
  font-weight: 700;
  display: flex;
  align-items: baseline;
  gap: 2px;
}

.metric-value span {
  font-size: 0.85rem;
  color: var(--text-secondary);
  font-weight: normal;
}

.metric-card.danger {
  background: var(--danger-bg);
  border-color: rgba(239, 68, 68, 0.3);
}
.metric-card.danger .metric-value { color: var(--danger-color); }

/* 折線圖捲動區 */
.charts-scroll-area {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding-right: 0.5rem; /* 預留捲動條空間 */
}

/* 客製化捲動條 */
.charts-scroll-area::-webkit-scrollbar { width: 6px; }
.charts-scroll-area::-webkit-scrollbar-track { background: rgba(0,0,0,0.1); border-radius: 10px; }
.charts-scroll-area::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }
.charts-scroll-area::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.3); }

.chart-box {
  padding: 1rem;
  min-height: 220px;
}
.chart-box h3 {
  margin: 0 0 1rem 0;
  font-size: 0.9rem;
  color: var(--text-primary);
  font-weight: 600;
}
.chart-container {
  height: 160px;
  width: 100%;
}

/* ================= 按鈕樣式 ================= */
button {
  width: 100%;
  border-radius: 8px;
  padding: 0.75rem;
  font-size: 0.9rem;
  font-weight: 600;
  background-color: rgba(255, 255, 255, 0.05);
  color: var(--text-primary);
  border: 1px solid rgba(255, 255, 255, 0.1);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  transition: all 0.2s;
}

button:hover:not(:disabled) {
  background-color: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.2);
}

button.primary {
  background-color: var(--accent-color);
  border-color: transparent;
}

button.primary:hover:not(:disabled) {
  background-color: var(--accent-hover);
}

button.primary.recording {
  background-color: transparent;
  border: 1px solid var(--danger-color);
  color: var(--danger-color);
}

button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.error-alert {
  margin-top: 1rem;
  padding: 0.75rem;
  background: var(--danger-bg);
  border-left: 3px solid var(--danger-color);
  color: var(--danger-color);
  font-size: 0.85rem;
  border-radius: 4px;
}

/* ---------- 新增 LogTerminal 樣式 ---------- */
.log-terminal-container {
  flex: 1;
  width: 100%;
  background-color: #09090b;
  border-top: 1px solid rgba(255,255,255,0.08);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-bottom-left-radius: 12px;
  border-bottom-right-radius: 12px;
  box-shadow: inset 0 4px 10px rgba(0,0,0,0.5);
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.4rem 1rem;
  background-color: rgba(255,255,255,0.05);
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.log-title {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

